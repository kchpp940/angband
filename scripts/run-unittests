#!/usr/bin/env bash
#
# run-unittests - Unified test runner for Angband unit tests
#
# Single entry point for building and running unit tests from anywhere in the
# project tree.  Works identically for CMake, Autotools, and manual
# Makefile.std builds, with a shared working directory so all builds use the
# same lib/gamedata/constants.txt.
#
# Usage:
#   run-unittests [options] [filter...]
#
# Filters (run all if none given):
#   Suite name          e.g.  player  effects  game  object
#   Individual test     e.g.  effects/destruction  player/birth
#
# Examples:
#   run-unittests -b                         Build and run all tests
#   run-unittests player effects             Run player + effects suites
#   run-unittests effects/destruction game/basic   Run only those two tests
#   run-unittests -b -v game                 Build and run game suite verbosely
#   run-unittests -B object                  Only build (all) tests

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
SRC_DIR="$PROJECT_ROOT/src"
TESTS_DIR="$SRC_DIR/tests"

VERBOSE=0
QUIET=0
FORCEPATH=0
USE_COLOR=1
BUILD=0
BUILD_ONLY=0
LIST_SUITES=0
FILTER_ARGS=""

usage() {
    cat <<'HELP'
Usage: run-unittests [options] [filter...]

Unified test runner for Angband unit tests.  Automatically detects the
project root and build system, sets the correct working directory so
lib/gamedata/constants.txt is resolved consistently, and supports
filtering by suite or individual test.

Options:
  -h, --help          Show this help message
  -b, --build         Build all tests before running
  -B, --build-only    Only build tests, do not run
  -v, --verbose       Show detailed test output
  -q, --quiet         Only show summary output
  -f, --forcepath     Force use of installed data paths
  -c, --color         Use ANSI colors (default)
  -C, --no-color      Disable ANSI colors
  -l, --list          List available test suites

Filters (run all if none specified):
  Suite name          e.g.  player effects game object
  Individual test     e.g.  effects/destruction  player/birth
HELP
}

ALL_SUITES="artifact cave command effects game message monster object parse
player trivial z-dice z-expression z-file z-quark z-queue z-textblock z-util
z-virt"

list_suites() {
    echo "Available test suites:"
    for s in $ALL_SUITES; do
        echo "  $s"
    done
}

detect_build_system() {
    if [ -f "$PROJECT_ROOT/build/CMakeCache.txt" ]; then
        if [ -f "$PROJECT_ROOT/build/build.ninja" ]; then
            echo "cmake-ninja"
        else
            echo "cmake-make"
        fi
    elif [ -f "$PROJECT_ROOT/Makefile" ] && [ -f "$PROJECT_ROOT/mk/buildsys.mk" ]; then
        echo "autotools"
    elif [ -f "$SRC_DIR/Makefile.std" ]; then
        echo "manual"
    else
        echo "unknown"
    fi
}

build_tests() {
    local build_system="$1"

    echo "Building tests (build system: $build_system)..."

    case "$build_system" in
        cmake-ninja)
            cd "$PROJECT_ROOT/build"
            ninja allunittests
            ;;
        cmake-make)
            cd "$PROJECT_ROOT/build"
            make allunittests
            ;;
        autotools)
            cd "$PROJECT_ROOT"
            make tests
            ;;
        manual)
            cd "$SRC_DIR"
            export TMPDIR="${TMPDIR:-/tmp}"
            make -f Makefile.std angband.a
            cd "$TESTS_DIR"
            make \
                CC="${CC:-cc}" \
                CFLAGS="-I. -I.. -I../.. -g -DTEST_OVERRIDE_PATHS" \
                CPPFLAGS="${CPPFLAGS:-}" \
                LDFLAGS="${LDFLAGS:-} -lm" \
                build
            ;;
        *)
            echo "Error: Could not detect build system." >&2
            echo "Configure CMake in build/ or run autotools first." >&2
            exit 1
            ;;
    esac
}

matches_filter() {
    local suite_test="$1"
    local filters="$2"
    local suite="${suite_test%%/*}"

    if [ -z "$filters" ]; then
        return 0
    fi

    for f in $filters; do
        if [ "$f" = "$suite_test" ]; then
            return 0
        fi
        if [ "$f" = "$suite" ]; then
            return 0
        fi
    done
    return 1
}

find_cmake_test_executables() {
    local filters="$1"
    local test_root="$PROJECT_ROOT/build/unittests"

    if [ ! -d "$test_root" ]; then
        return
    fi

    while IFS= read -r -d '' path; do
        local name parent grandparent suite_test
        name=$(basename "$path")
        parent=$(basename "$(dirname "$path")")
        grandparent=$(basename "$(dirname "$(dirname "$path")")")
        suite_test="${grandparent}/${parent}"
        if matches_filter "$suite_test" "$filters"; then
            echo "$path"
        fi
    done < <(find "$test_root" -mindepth 3 -maxdepth 3 -type f -perm -u+x -print0 2>/dev/null)
}

find_make_test_executables() {
    local filters="$1"

    while IFS= read -r -d '' path; do
        local dir name suite_test
        dir=$(basename "$(dirname "$path")")
        name=$(basename "$path" .exe)
        suite_test="${dir}/${name}"
        if matches_filter "$suite_test" "$filters"; then
            echo "$path"
        fi
    done < <(find "$TESTS_DIR" -mindepth 2 -maxdepth 2 -type f -name '*.exe' -perm -u+x -print0 2>/dev/null)
}

collect_test_executables() {
    local build_system="$1"
    local filters="$2"

    case "$build_system" in
        cmake-ninja|cmake-make)
            find_cmake_test_executables "$filters"
            ;;
        *)
            find_make_test_executables "$filters"
            ;;
    esac
}

get_suite_test_name() {
    local path="$1"
    local build_system="$2"

    case "$build_system" in
        cmake-ninja|cmake-make)
            local parent grandparent
            parent=$(basename "$(dirname "$path")")
            grandparent=$(basename "$(dirname "$(dirname "$path")")")
            echo "${grandparent}/${parent}"
            ;;
        *)
            local dir name
            dir=$(basename "$(dirname "$path")")
            name=$(basename "$path" .exe)
            echo "${dir}/${name}"
            ;;
    esac
}

color_red()   { if [ "$USE_COLOR" -eq 1 ]; then printf '\033[01;31m'; fi; }
color_green() { if [ "$USE_COLOR" -eq 1 ]; then printf '\033[01;32m'; fi; }
color_yellow(){ if [ "$USE_COLOR" -eq 1 ]; then printf '\033[01;33m'; fi; }
color_reset() { if [ "$USE_COLOR" -eq 1 ]; then printf '\033[0m'; fi; }

run_tests() {
    local build_system="$1"
    local filters="$2"
    local execs
    execs=$(collect_test_executables "$build_system" "$filters")

    if [ -z "$execs" ]; then
        echo "Error: No test executables found matching: $filters" >&2
        echo "Try building with -b first." >&2
        exit 1
    fi

    local test_args=()
    if [ "$VERBOSE" -eq 1 ]; then
        test_args+=("-v")
    fi
    if [ "$FORCEPATH" -eq 1 ]; then
        test_args+=("-f")
    fi

    export TEST_WORKING_DIRECTORY="$PROJECT_ROOT"

    local pass=0 total=0 exitcode=0
    local count
    count=$(echo "$execs" | grep -c . || true)

    if [ "$QUIET" -eq 0 ]; then
        echo "Running $count test suites (working dir: $PROJECT_ROOT):"
    fi

    cd "$PROJECT_ROOT"

    while IFS= read -r path; do
        [ -z "$path" ] && continue

        local suite_test
        suite_test=$(get_suite_test_name "$path" "$build_system")

        local output
        output=$("$path" "${test_args[@]}" 2>&1) || true
        local status=$?

        if [ "$status" -ne 0 ]; then
            if [ "$QUIET" -eq 0 ]; then
                printf "    %-30s $(color_red)Suite died$(color_reset)\n" "$suite_test"
            fi
            exitcode=$status
            total=$((total + 1))
            continue
        fi

        local last_line
        last_line=$(echo "$output" | tail -n 1)

        if echo "$last_line" | grep -qE '[^:]+ finished: [0-9]+/[0-9]+ passed'; then
            local p t
            p=$(echo "$last_line" | sed -E 's/.* finished: ([0-9]+)\/[0-9]+.*/\1/')
            t=$(echo "$last_line" | sed -E 's/.* finished: [0-9]+\/([0-9]+).*/\1/')
            pass=$((pass + p))
            total=$((total + t))

            if [ "$QUIET" -eq 0 ]; then
                if [ "$VERBOSE" -eq 1 ]; then
                    echo "$output" | sed '$d' | while IFS= read -r line; do
                        echo "      $line"
                    done
                    printf "    %s finished: " "$suite_test"
                else
                    printf "    %-30s " "$suite_test"
                fi
                if [ "$p" -eq "$t" ]; then
                    printf "$(color_green)%s/%s passed$(color_reset)\n" "$p" "$t"
                elif [ "$p" -ge $((t * 90 / 100)) ]; then
                    printf "$(color_yellow)%s/%s passed$(color_reset)\n" "$p" "$t"
                else
                    printf "$(color_red)%s/%s passed$(color_reset)\n" "$p" "$t"
                fi
            fi
        else
            if [ "$QUIET" -eq 0 ]; then
                printf "    %-30s $(color_red)Malformed output$(color_reset)\n" "$suite_test"
            fi
            exitcode=1
        fi
    done <<< "$execs"

    local perc
    if [ "$total" -gt 0 ]; then
        perc=$(awk "BEGIN {printf \"%.1f\", ($pass * 100) / $total}")
    else
        perc="100.0"
    fi

    local c
    if [ "$total" -gt 0 ]; then
        if [ "$pass" -eq "$total" ]; then c=$(color_green)
        elif [ "$pass" -ge $((total * 90 / 100)) ]; then c=$(color_yellow)
        else c=$(color_red); fi
    else
        c=$(color_green)
    fi

    echo "Total: ${c}${pass}/${total}$(color_reset) passed (${c}${perc}%$(color_reset))"

    if [ "$exitcode" -ne 0 ] || [ "$pass" -ne "$total" ]; then
        exit 1
    fi
    exit 0
}

while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        -b|--build) BUILD=1; shift ;;
        -B|--build-only) BUILD=1; BUILD_ONLY=1; shift ;;
        -v|--verbose) VERBOSE=1; QUIET=0; shift ;;
        -q|--quiet) QUIET=1; VERBOSE=0; shift ;;
        -f|--forcepath) FORCEPATH=1; shift ;;
        -c|--color) USE_COLOR=1; shift ;;
        -C|--no-color) USE_COLOR=0; shift ;;
        -l|--list) LIST_SUITES=1; shift ;;
        -*) echo "Unknown option: $1" >&2; usage >&2; exit 1 ;;
        *)
            if [ -z "$FILTER_ARGS" ]; then FILTER_ARGS="$1"
            else FILTER_ARGS="$FILTER_ARGS $1"; fi
            shift ;;
    esac
done

if [ "$LIST_SUITES" -eq 1 ]; then
    list_suites
    exit 0
fi

BUILD_SYSTEM=$(detect_build_system)

if [ "$BUILD" -eq 1 ]; then
    build_tests "$BUILD_SYSTEM"
fi

if [ "$BUILD_ONLY" -eq 1 ]; then
    exit 0
fi

run_tests "$BUILD_SYSTEM" "$FILTER_ARGS"
