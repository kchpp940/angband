/**
 * \file build-capabilities.h
 * \brief Unified build capability declarations
 *
 * This file is generated by the build system (CMake or Autotools) and
 * declares all compiled-in capabilities.
 *
 * ALL frontend code should include this header (via h-basic.h) and check the
 * ANGBAND_CAP_* macros instead of checking the legacy USE_* / SOUND / ALLOW_BORG
 * macros directly.  The legacy macros are preserved for backward
 * compatibility.
 *
 * Copyright (c) 2026 Angband contributors
 *
 * This software may be copied and distributed for educational, research,
 * and not for profit purposes provided that this copyright and statement
 * are included in all such copies.  Other copyrights may also apply.
 */

#ifndef INCLUDED_BUILD_CAPABILITIES_H
#define INCLUDED_BUILD_CAPABILITIES_H

#include <stdbool.h>
#include <stddef.h>
#include <stdio.h>
#include <string.h>

#ifdef __cplusplus
extern "C" {
#endif

/* ====================================================================== */
/* Player Frontends                                                           */
/* ====================================================================== */

/*
 * Every capability below is either 0 (disabled) or 1 (enabled).  This is
 * enforced by both CMake (#cmakedefine01) and Autotools (AC_DEFINE with
 * explicit 0/1).  Using numeric values lets code write:
 *
 *     #if ANGBAND_CAP_FRONTEND_GCU
 *         ...
 *     #endif
 *
 * which is simpler than checking for definedness, and plays nicely with
 * the fallback defaults in h-basic.h.
 */

/* Curses (GCU) frontend */
#cmakedefine01 ANGBAND_CAP_FRONTEND_GCU

/* SDL 1.x frontend */
#cmakedefine01 ANGBAND_CAP_FRONTEND_SDL

/* SDL 2.x frontend */
#cmakedefine01 ANGBAND_CAP_FRONTEND_SDL2

/* X11 frontend */
#cmakedefine01 ANGBAND_CAP_FRONTEND_X11

/* Windows frontend */
#cmakedefine01 ANGBAND_CAP_FRONTEND_WINDOWS

/* IBM / DOS frontend */
#cmakedefine01 ANGBAND_CAP_FRONTEND_IBM

/* Cocoa (macOS) frontend */
#cmakedefine01 ANGBAND_CAP_FRONTEND_COCOA

/* ====================================================================== */
/* Sound Support                                                           */
/* ====================================================================== */

/* Generic sound support (set to 1 if ANY sound backend is enabled) */
#cmakedefine01 ANGBAND_CAP_SOUND

/* SDL 1.x mixer sound */
#cmakedefine01 ANGBAND_CAP_SOUND_SDL

/* SDL 2.x mixer sound */
#cmakedefine01 ANGBAND_CAP_SOUND_SDL2

/* Windows built-in sound */
#cmakedefine01 ANGBAND_CAP_SOUND_WINDOWS

/* Cocoa sound */
#cmakedefine01 ANGBAND_CAP_SOUND_COCOA

/* ====================================================================== */
/* Auxiliary Frontends                                                    */
/* ====================================================================== */

/* Spoiler generation frontend */
#cmakedefine01 ANGBAND_CAP_FRONTEND_SPOIL

/* Statistics frontend */
#cmakedefine01 ANGBAND_CAP_FRONTEND_STATS

/* Test frontend */
#cmakedefine01 ANGBAND_CAP_FRONTEND_TEST

/* ====================================================================== */
/* Stats Backend                                                           */
/* ====================================================================== */

/* Statistics backend support */
#cmakedefine01 ANGBAND_CAP_STATS_BACKEND

/* ====================================================================== */
/* Borg Support                                                          */
/* ====================================================================== */

/* Borg (autoplay) */
#cmakedefine01 ANGBAND_CAP_BORG

/* Borg characters allowed in high scores */
#cmakedefine01 ANGBAND_CAP_BORG_HIGH_SCORES

/* ====================================================================== */
/* Installation / Path Options                                               */
/* ====================================================================== */

/* Setgid installation (shared multi-user setup) */
#cmakedefine01 ANGBAND_CAP_SETGID

/* Private user paths (per-user save/score files in ~/.angband) */
#cmakedefine01 ANGBAND_CAP_PRIVATE_PATHS

/* Gamedata stored in lib path */
#cmakedefine01 ANGBAND_CAP_GAMEDATA_IN_LIB

/* ====================================================================== */
/* Backward-Compatibility Macros                                         */
/* ====================================================================== */
/* These map the new ANGBAND_CAP_* macros to the legacy macros so     */
/* that existing code continues to work without modification.              */
/* ====================================================================== */

#if ANGBAND_CAP_FRONTEND_GCU
# ifndef USE_GCU
#  define USE_GCU
# endif
# ifndef USE_NCURSES
#  define USE_NCURSES
# endif
#endif

#if ANGBAND_CAP_FRONTEND_SDL
# ifndef USE_SDL
#  define USE_SDL
# endif
#endif

#if ANGBAND_CAP_FRONTEND_SDL2
# ifndef USE_SDL2
#  define USE_SDL2
# endif
#endif

#if ANGBAND_CAP_FRONTEND_X11
# ifndef USE_X11
#  define USE_X11
# endif
#endif

#if ANGBAND_CAP_FRONTEND_WINDOWS
# ifndef USE_WIN
#  define USE_WIN
# endif
# ifndef WINDOWS
#  define WINDOWS
# endif
#endif

#if ANGBAND_CAP_FRONTEND_IBM
# ifndef USE_IBM
#  define USE_IBM
# endif
#endif

#if ANGBAND_CAP_SOUND
# ifndef SOUND
#  define SOUND
# endif
#endif

#if ANGBAND_CAP_SOUND_SDL
# ifndef SOUND_SDL
#  define SOUND_SDL
# endif
#endif

#if ANGBAND_CAP_SOUND_SDL2
# ifndef SOUND_SDL2
#  define SOUND_SDL2
# endif
#endif

#if ANGBAND_CAP_FRONTEND_SPOIL
# ifndef USE_SPOIL
#  define USE_SPOIL
# endif
#endif

#if ANGBAND_CAP_FRONTEND_STATS
# ifndef USE_STATS
#  define USE_STATS
# endif
#endif

#if ANGBAND_CAP_FRONTEND_TEST
# ifndef USE_TEST
#  define USE_TEST
# endif
#endif

#if ANGBAND_CAP_BORG
# ifndef ALLOW_BORG
#  define ALLOW_BORG
# endif
#endif

#if ANGBAND_CAP_BORG_HIGH_SCORES
# ifndef SCORE_BORGS
#  define SCORE_BORGS
# endif
#endif

#if ANGBAND_CAP_SETGID
# ifndef SETGID
#  define SETGID
# endif
#endif

#if ANGBAND_CAP_PRIVATE_PATHS
# ifndef USE_PRIVATE_PATHS
#  define USE_PRIVATE_PATHS
# endif
#endif

#if ANGBAND_CAP_GAMEDATA_IN_LIB
# ifndef GAMEDATA_IN_LIB
#  define GAMEDATA_IN_LIB
# endif
#endif

/* ====================================================================== */
/* Runtime Capability Introspection                                            */
/* ====================================================================== */

struct angband_capability_entry {
	const char *name;
	bool enabled;
	const char *description;
};

#define ANGBAND_CAPABILITY_LIST_BEGIN() \
	static const struct angband_capability_entry angband_capabilities[] = {

#define ANGBAND_CAPABILITY(NAME, DESC) \
	{ #NAME, ANGBAND_CAP_##NAME, DESC },

#define ANGBAND_CAPABILITY_LIST_END() \
	{ NULL, false, NULL } \
	};

ANGBAND_CAPABILITY_LIST_BEGIN()
	ANGBAND_CAPABILITY(FRONTEND_GCU, "Curses (GCU) text frontend")
	ANGBAND_CAPABILITY(FRONTEND_SDL, "SDL 1.x graphical frontend")
	ANGBAND_CAPABILITY(FRONTEND_SDL2, "SDL 2.x graphical frontend")
	ANGBAND_CAPABILITY(FRONTEND_X11, "X11 graphical frontend")
	ANGBAND_CAPABILITY(FRONTEND_WINDOWS, "Windows graphical frontend")
	ANGBAND_CAPABILITY(FRONTEND_IBM, "IBM/DOS text frontend")
	ANGBAND_CAPABILITY(FRONTEND_COCOA, "macOS Cocoa frontend")
	ANGBAND_CAPABILITY(SOUND, "Generic sound support")
	ANGBAND_CAPABILITY(SOUND_SDL, "SDL 1.x mixer sound")
	ANGBAND_CAPABILITY(SOUND_SDL2, "SDL 2.x mixer sound")
	ANGBAND_CAPABILITY(SOUND_WINDOWS, "Windows built-in sound")
	ANGBAND_CAPABILITY(SOUND_COCOA, "macOS Cocoa sound")
	ANGBAND_CAPABILITY(FRONTEND_SPOIL, "Spoiler generation frontend")
	ANGBAND_CAPABILITY(FRONTEND_STATS, "Statistics frontend")
	ANGBAND_CAPABILITY(FRONTEND_TEST, "Test frontend")
	ANGBAND_CAPABILITY(STATS_BACKEND, "Statistics backend support")
	ANGBAND_CAPABILITY(BORG, "Borg autoplay support")
	ANGBAND_CAPABILITY(BORG_HIGH_SCORES, "Borg characters in high scores")
	ANGBAND_CAPABILITY(SETGID, "Setgid shared installation")
	ANGBAND_CAPABILITY(PRIVATE_PATHS, "Private user paths (~/.angband)")
	ANGBAND_CAPABILITY(GAMEDATA_IN_LIB, "Gamedata stored in lib path")
ANGBAND_CAPABILITY_LIST_END()

/* ====================================================================== */
/* Runtime Query API                                                            */
/* ====================================================================== */

static inline bool angband_capability_has(const char *name)
{
	size_t i;
	for (i = 0; angband_capabilities[i].name != NULL; i++) {
		if (strcmp(angband_capabilities[i].name, name) == 0) {
			return angband_capabilities[i].enabled;
		}
	}
	return false;
}

static inline void angband_capability_print_report(void)
{
	size_t i;
	fprintf(stderr, "Angband build capabilities:\n");
	for (i = 0; angband_capabilities[i].name != NULL; i++) {
		fprintf(stderr, "  %-30s %s\n",
			angband_capabilities[i].name,
			angband_capabilities[i].enabled ? "YES" : "NO ");
		if (angband_capabilities[i].description) {
			fprintf(stderr, "    %s\n",
				angband_capabilities[i].description);
		}
	}
}

#ifdef __cplusplus
}
#endif

#endif /* !INCLUDED_BUILD_CAPABILITIES_H */
